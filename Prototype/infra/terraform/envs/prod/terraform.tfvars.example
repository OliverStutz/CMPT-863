# Copy to terraform.tfvars and fill in. Nothing here is secret.
project_id = "REPLACE-study-prod" # OPEN Q: still to be named
region     = "northamerica-northeast1"
# firestore_location = ""        # defaults to region; fixed once created

min_instances = 1 # during active recruitment; 0 otherwise
max_instances = 10

domain = "" # OPEN Q; check Cloud Run domain mapping availability for the region first

alert_email     = "REPLACE@example.org"
billing_account = "" # XXXXXX-XXXXXX-XXXXXX, or empty to create the budget by hand
budget_amount   = 25

ci_deploy_sa_email = "ci-deploy@REPLACE-study-prod.iam.gserviceaccount.com" # bootstrap output

# Prod: protect everything.
firestore_delete_protection = true
run_deletion_protection     = true
force_destroy_buckets       = false

# image_digest is set by CI (deploy.yml); leave unset for the first apply.
